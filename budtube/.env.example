# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Random string used to sign session JWTs. The app falls back to a
# built-in dev secret if unset — set this in production.
SESSION_SECRET=

# Site admin account, created/updated by `npm run db:admin`.
# This account gets the OWNER role: full staff powers plus the /admin
# panel for promoting/demoting other admins. It can never be demoted.
ADMIN_USERNAME=mcrashcraft
ADMIN_EMAIL=support@mcrashcraft.com
ADMIN_PASSWORD=

# Didit ID verification (https://docs.didit.me). Optional — when unset,
# the age gate uses date-of-birth entry only.
# Get the API key and workflow ID from your Didit dashboard.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# Hard monthly cap on Didit API sessions so the free tier (500/month)
# is never exceeded. Past the cap the age gate falls back to DOB entry.
DIDIT_MONTHLY_CAP=450
