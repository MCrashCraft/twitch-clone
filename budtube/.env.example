# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Random string used to sign session JWTs. The app falls back to a
# built-in dev secret if unset — set this in production.
SESSION_SECRET=

# Site admin account, created/updated by `npm run db:admin`.
ADMIN_USERNAME=mcrashcraft
ADMIN_EMAIL=support@mcrashcraft.com
ADMIN_PASSWORD=

# SMTP settings for the /support contact form.
SMTP_HOST=mail.mcrashcraft.com
SMTP_PORT=587
SMTP_USER=info@mcrashcraft.com
SMTP_PASS=

# Where support form messages are delivered (defaults to SMTP_USER).
SUPPORT_EMAIL=info@mcrashcraft.com
